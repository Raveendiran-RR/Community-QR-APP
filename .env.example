# Community QR Check-in — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
#
# These are used in the Admin dashboard at runtime.
# For Vercel: add them under Settings > Environment Variables.

# Your Google Apps Script Web App URL
# Get this from: Apps Script > Deploy > Manage deployments
VITE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Your Google Sheet ID (from the Sheet URL)
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
VITE_SHEET_ID=YOUR_GOOGLE_SHEET_ID_HERE

# Admin PIN (keep this strong — default is 9999, change immediately)
# This is also configurable inside the app after first login.
VITE_ADMIN_PIN=9999
